static/img/screens/

# Lighthouse CI run output. Reports are regenerated by every `lhci autorun`
# and uploaded to temporary public storage; keeping them in git would add a
# few hundred KB of noise per run and tell a reader nothing the gate does not.
.lighthouseci/
